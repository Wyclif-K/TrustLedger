# =============================================================================
# TrustLedger USSD Service - Environment Variables
# Copy to .env and fill in your values. Never commit .env to git.
# =============================================================================

# ─── Server ───────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── TrustLedger blockchain-core backend API ─────────────────────────────────
# Internal URL only (Docker: http://host.docker.internal:3000/api/v1 on Windows/Mac)
BACKEND_API_URL=http://localhost:3000/api/v1

# Must match USSD_SERVICE_KEY in blockchain-core/backend/.env (header X-Service-Key).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BACKEND_API_KEY=change-me-to-match-backend-USSD_SERVICE_KEY

# ─── Africa's Talking ────────────────────────────────────────────────────────
# Get from https://account.africastalking.com — required for SMS confirmations only.
# USSD webhooks work without AT credentials; configure the callback URL in the AT dashboard.
AT_USERNAME=sandbox
AT_API_KEY=
# Must match the shortcode you create in Africa's Talking (also update app deposit_ussd_shortcode).
AT_SHORTCODE=*384*13948#

# ─── Redis (Session Store) ───────────────────────────────────────────────────
# Multi-step USSD state. On Railway: add Redis, reference REDIS_URL on the same service as the API (embedded bridge).
# TLS (Railway): URL often starts with rediss:// — supported by the session client.
REDIS_ENABLED=true
REDIS_URL=redis://localhost:6379
REDIS_SESSION_TTL=120            # Session TTL in seconds (USSD timeout)

# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=info

# ─── Rate Limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=200
